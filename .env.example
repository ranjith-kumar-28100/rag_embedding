# rag_embedding configuration — copy to `.env` and fill in.
# Library settings use the RAG_EMBED_ prefix; the microservice's infra settings
# use RAG_EMBED_SVC_. `.env` is gitignored; this template is safe to commit.
# Only the Azure/Qdrant keys are secrets.

# --- dense embeddings (§5.1) ------------------------------------------------
# "sentence_transformers" (fully local, default) or "azure".
RAG_EMBED_EMBEDDING_PROVIDER=sentence_transformers
RAG_EMBED_EMBEDDING_BATCH_SIZE=64
RAG_EMBED_LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBED_LOCAL_EMBEDDING_DEVICE=cpu

# azure (used only when provider == azure) — the only egress path.
RAG_EMBED_AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
RAG_EMBED_AZURE_OPENAI_API_KEY=<your-azure-openai-key>
RAG_EMBED_AZURE_OPENAI_API_VERSION=2024-10-21
RAG_EMBED_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# --- sparse / BM25 (§5.2) ---------------------------------------------------
RAG_EMBED_SPARSE_ENABLED=true
RAG_EMBED_BM25_TOKENIZER=default
RAG_EMBED_BM25_K1=1.2
RAG_EMBED_BM25_B=0.75
# Expected document length for BM25 length normalisation (streaming encoder).
RAG_EMBED_BM25_AVG_LEN=256

# --- qdrant (§6) ------------------------------------------------------------
RAG_EMBED_QDRANT_URL=http://localhost:6333
# RAG_EMBED_QDRANT_API_KEY=
RAG_EMBED_COLLECTION_PREFIX=rag
RAG_EMBED_HNSW_M=16
RAG_EMBED_HNSW_EF_CONSTRUCT=128
RAG_EMBED_HNSW_EF=64
# none | int8 | product
RAG_EMBED_QUANTIZATION=int8
RAG_EMBED_ON_DISK_VECTORS=true
RAG_EMBED_ON_DISK_PAYLOAD=true

# --- retrieval (§8) ---------------------------------------------------------
# rrf | dbsf
RAG_EMBED_FUSION=rrf
RAG_EMBED_TOP_K=10
RAG_EMBED_CHILD_PREFETCH_K=50
RAG_EMBED_WITH_PARENTS=true

# --- rerank (§8.4) — local open-source cross-encoder ------------------------
# Off by default, and not a marginal cost: one forward pass per candidate.
# Measured on CPU — bge-reranker-base ~140 ms @10 candidates, ~610 ms @50;
# ms-marco-MiniLM ~25 ms @10, ~95 ms @50; fused search alone is ~10-20 ms.
# Turn it on when recall@k is already good but the ordering is not.
# Models (both open weights, both offline-cacheable via `make prefetch`):
#   BAAI/bge-reranker-base                 (MIT, stronger, ~280 MB)
#   cross-encoder/ms-marco-MiniLM-L-6-v2   (Apache-2.0, ~4x faster, ~90 MB)
RAG_EMBED_RERANK_ENABLED=false
RAG_EMBED_RERANK_MODEL=BAAI/bge-reranker-base
RAG_EMBED_RERANK_DEVICE=cpu
RAG_EMBED_RERANK_BATCH_SIZE=32
RAG_EMBED_RERANK_MAX_LENGTH=512
# How many fused hits get re-scored. Must be >= top_k, or reranking is a no-op.
RAG_EMBED_RERANK_CANDIDATES=50

# --- parent docstore (§6.2) -------------------------------------------------
# sqlite (default) | qdrant
RAG_EMBED_DOCSTORE=sqlite

# --- evaluation (§10) -------------------------------------------------------
# ollama (local, default) | azure. Ollama: `ollama pull mistral` + daemon running.
RAG_EMBED_RAGAS_LLM_PROVIDER=ollama
RAG_EMBED_RAGAS_MODEL=mistral
RAG_EMBED_OLLAMA_BASE_URL=http://localhost:11434
RAG_EMBED_RAGAS_JUDGE_DEPLOYMENT=gpt-4o-mini
# LLM-judged metrics are slow and only indicative with a small local judge.
RAG_EMBED_RAGAS_LLM_METRICS_ENABLED=false
# Answer generation for faithfulness/answer_relevancy — deferred (§18).
RAG_EMBED_GENERATION_ENABLED=false

# --- input (§7) -------------------------------------------------------------
# upload (API multipart, primary) | path (dev-only local directory)
RAG_EMBED_CHUNK_SOURCE=upload
# RAG_EMBED_CHUNK_PATH=./chunks
RAG_EMBED_MAX_UPLOAD_MB=500

# --- air-gap ----------------------------------------------------------------
# true => force HF/transformers offline + no telemetry; rejects Azure providers.
RAG_EMBED_OFFLINE=false

# ===========================================================================
# Microservice infra (service_embed/ + ui/) — prefix RAG_EMBED_SVC_.
# Only needed when running the FastAPI/Celery/Streamlit stack. Compose sets
# these itself.
# ===========================================================================
RAG_EMBED_SVC_REDIS_URL=redis://localhost:6379/0
RAG_EMBED_SVC_DATABASE_URL=sqlite:///./data/rag_embedding.db
RAG_EMBED_SVC_DATA_DIR=./data
RAG_EMBED_SVC_UPLOAD_DIR=./data/uploads
# UI -> API base URL (the Streamlit app calls this).
RAG_EMBED_SVC_API_BASE_URL=http://localhost:8001

# --- tests ------------------------------------------------------------------
# Set to run the opt-in integration tests against a real Qdrant.
# RAG_EMBED_TEST_QDRANT_URL=http://localhost:6333
